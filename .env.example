# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
# Dimuat otomatis oleh server/index.js (process.loadEnvFile).

# Kata sandi panel admin (minimal 12 karakter; wajib unik).
ADMIN_PASSWORD=

# Port API sekaligus peladen hasil build di mode produksi.
PORT=8392

# Basis data MySQL/MariaDB — sumber kebenaran tunggal (tidak ada berkas cadangan).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kemenag_wsb
DB_PASSWORD=
DB_NAME=kemenag_wsb
